NODE_ENV=development
PORT=5000

# Create this server-side key in Google AI Studio. Never expose it through Vite.
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Comma-separated production origins, if you need origins beyond the defaults.
ALLOWED_ORIGINS=https://peejaydavid.dev,https://www.peejaydavid.dev

# Contact form (Resend example)
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=Portfolio Contact <onboarding@resend.dev>
EMAIL_TO=davidpeejay@gmail.com
